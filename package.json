{
  "name": "@mojaloop/thirdparty-api-svc",
  "version": "15.1.7",
  "private": true,
  "description": "The thirdparty-api-svc service is used to handle HTTP requests from third parties.",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "audit:fix": "npm audit fix",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc",
    "build": "tsc -p ./tsconfig.build.json && cp ./src/interface/api.yaml ./dist/src/interface/api.yaml",
    "build:openapi": "openapi bundle --output ./src/interface/api.yaml --ext yaml ./src/interface/api-template.yaml",
    "dep:check": "npx ncu -e 2",
    "dep:update": "npx ncu -u",
    "dev": "ts-node-dev --no-notify -r tsconfig-paths/register -P ./tsconfig.json ./src/cli.ts all",
    "docker:build": "docker build --build-arg NODE_VERSION=\"$(cat .nvmrc)-alpine\" -t mojaloop/thirdparty-api-svc:local -f ./Dockerfile ./",
    "docker:run": "docker run -p 3008:3008 thirdparty-api-svc:local",
    "docker:up": "docker-compose -f docker-compose.yml up",
    "docker:stop": "docker-compose -f docker-compose.yml stop",
    "docker:rm": "docker-compose -f docker-compose.yml rm -f -v",
    "docker:down": "docker-compose -f docker-compose.yml down -v",
    "docker:clean": "docker-compose -f docker-compose.yml down --rmi local",
    "lint": "eslint test src",
    "lint:fix": "eslint --fix test src",
    "release": "standard-version --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "snapshot": "standard-version --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'chore(snapshot): {{currentTag}}'",
    "standard": "echo '\\033[1;33m  This project uses eslint instead of standard. Use `npm run lint` instead.'",
    "start:ts": "ts-node -r tsconfig-paths/register -P ./tsconfig.json ./src/cli.ts all",
    "start": "node ./dist/src/cli.js all",
    "test": "npm run test:unit",
    "test:bdd": "NODE_OPTIONS=--experimental-vm-modules jest --config './jest.bdd.config.js' --runInBand --testMatch '**/test/step-definitions/**/*.step.ts'",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageThreshold='{}' --testMatch '**/test/unit/**/*.(test|spec).ts'",
    "test:coverage-check": "NODE_OPTIONS=--experimental-vm-modules jest -w 1 --coverage --testMatch '**/test/unit/**/*.(test|spec).ts'",
    "test:integration": "echo \"No integration tests defined\"",
    "test:functional": "echo \"No functional tests defined\"",
    "test:integration-tmp": "jest --collectCoverage=false --testMatch '**/test/integration/**/*.test.ts'",
    "test:junit": "NODE_OPTIONS=--experimental-vm-modules jest --reporters=default --reporters=jest-junit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest -w 1 --testMatch '**/test/unit/**/*.(test|spec).ts'",
    "test:xunit": "npm run test:unit",
    "validate:api": "swagger-cli validate ./src/interface/api.yaml",
    "watch": "tsc -w",
    "wait-4-docker": "node ./scripts/_wait4_all.js"
  },
  "pre-commit": [
    "lint",
    "dep:check",
    "audit:check",
    "test"
  ],
  "lint-staged": {
    "*.{js,ts}": "eslint --cache --fix"
  },
  "_moduleAliases": {
    "~": "dist/src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojaloop/thirdparty-api-svc.git"
  },
  "keywords": [
    "metrics",
    "central",
    "services",
    "pisp"
  ],
  "author": "lewisdaly",
  "contributors": [
    "Lewis Daly <lewis@vesselstech.com>",
    "Paweł Marzec <pawel.marzec@modusbox.com>",
    "Sridhar Voruganti <sridhar.voruganti@modusbox.com>"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mojaloop/thirdparty-api-svc/issues"
  },
  "homepage": "https://github.com/mojaloop/thirdparty-api-svc#readme",
  "devDependencies": {
    "@redocly/cli": "2.65.0",
    "@types/jest": "^30.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "24.13.5",
    "@types/rc": "^1.2.4",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "audit-ci": "^7.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-cucumber": "^4.5.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "23.1.1",
    "pre-commit": "^2.0.0",
    "prettier": "^3.9.10",
    "prom-client": "15.1.3",
    "standard-version": "^9.5.0",
    "swagger-cli": "^4.0.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hapi/good": "^9.0.1",
    "@hapi/hapi": "^21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/vision": "^7.0.3",
    "@mojaloop/api-snippets": "^18.4.3",
    "@mojaloop/central-services-shared": "19.0.0",
    "@mojaloop/central-services-stream": "11.12.0",
    "blipp": "^4.0.2",
    "commander": "15.0.0",
    "depcheck": "^1.4.7",
    "module-alias": "^2.3.4",
    "mustache": "^4.2.0",
    "parse-strings-in-object": "^2.0.0",
    "rc": "^1.2.8",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "form-data": "4.0.6",
    "cross-spawn": "7.0.6",
    "qs": "6.16.0",
    "glob@10.4.5": "10.5.0",
    "glob@11.0.3": "11.1.0",
    "js-yaml@4": "4.3.2",
    "axios": "1.20.0",
    "lodash": "4.18.1",
    "diff": "4.0.4",
    "lodash-es": "4.18.1",
    "minimatch@3.0.5": "3.1.5",
    "minimatch@3.1.2": "3.1.5",
    "minimatch@5.1.6": "5.1.9",
    "minimatch@7.4.6": "7.4.9",
